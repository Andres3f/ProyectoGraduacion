# ── Base de datos ──────────────────────────────────────────
DATABASE_URL=postgresql://optirutas:optirutas_secret@db:5432/optirutas_jalapa
POSTGRES_USER=optirutas
POSTGRES_PASSWORD=optirutas_secret
POSTGRES_DB=optirutas_jalapa

# ── JWT ────────────────────────────────────────────────────
SECRET_KEY=cambia-este-secreto-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ────────────────────────────────────────────────────
DEBUG=true

# ── CORS ───────────────────────────────────────────────────
# Orígenes del frontend (separados por coma). En producción apunta al dominio
# real del frontend, nunca "*" con credenciales.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# ── OpenRouteService (opcional, mejora la precisión de las distancias) ──
# Si se deja vacío, el sistema usa distancia Haversine / línea recta como fallback.
ORS_API_KEY=


# ── Optimizador / geografía ────────────────────────────────
# Depósito base (centro de Jalapa, GT).
DEPOT_LAT=14.6347
DEPOT_LNG=-89.9889